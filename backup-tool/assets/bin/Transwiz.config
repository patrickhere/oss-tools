<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ForensiTUserProfileTransferWizard xmlns="https://www.ForensiT.com/schemas">
  <Parameters>
    <!-- ForensiT Transwiz run options -->
    <Domain></Domain>
    <NoRename>True</NoRename>
    <NoRestore>False</NoRestore>
    <OverWrite>False</OverWrite>    
    
    <!-- Additional Backup Settings -->
    <!-- Set additional backup paths. See User Guide for more details. -->
    <!-- E.g. <Include>C:\Data|C:\Users\Public\Documents\*.pdf*.xls*docx|C:\Users\Public\Desktop\*.txt</Include> -->
    <Include></Include>
    
     <!-- Exclude Profile Folders -->
    <ExcludeFolders></ExcludeFolders>
    
    <!-- Exclude file types -->
    <Exclude></Exclude>
    

  </Parameters>
</ForensiTUserProfileTransferWizard>